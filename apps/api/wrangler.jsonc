{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "common-intelligence-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "LOCAL_DEV_AUTH_BYPASS": "true",
    "ADMIN_IP_ALLOWLIST": "141.11.146.88,142.249.36.139,58.38.6.240,240e:38d:8d42:d000::/64,127.0.0.1,::1",
    "GITHUB_ORG_NAME": "common-intelligence-org"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "common-intelligence",
    "migrations_dir": "../../docs/backend/migrations"
  }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "api",
      "account_id": "a17920dd88d0eec815350eba8ecfe9d8",
      "workers_dev": true,
      "vars": {
        "APP_ORIGIN": "https://api.common-intelligence.workers.dev",
        "ADMIN_IP_ALLOWLIST": "141.11.146.88,142.249.36.139,58.38.6.240,240e:38d:8d42:d000::/64",
        "GITHUB_ORG_NAME": "common-intelligence-org"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "common-intelligence",
        "database_id": "6566e892-dd50-4bd1-895a-541c060aae7f",
        "migrations_dir": "../../docs/backend/migrations"
      }]
    }
  }
}
