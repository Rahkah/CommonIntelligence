# ==============================================================================
# Common Intelligence — Environment Variables Example
# ==============================================================================
# Copy to apps/web/.env.local for frontend local configuration.
# Backend variables below are documented for the Cloudflare Workers + D1 service
# described in docs/backend/ and DEPLOYMENT.md.

# --- Frontend (Vite) ---
# Data source mode: "demo" uses clearly labeled local demo data; "api" calls live backend
VITE_DATA_MODE=demo
# Base URL of the Hono / Cloudflare Workers API (leave empty for same-origin deployment)
VITE_API_BASE_URL=
# Public canonical site URL used in join.txt snippets and GitHub README badge snippets
VITE_PUBLIC_APP_URL=https://commonintelligence.org
# Optional custom polling interval (ms) for /live activity feed (default: 15000)
VITE_LIVE_POLL_INTERVAL_MS=15000

# --- Backend (Cloudflare Workers Secrets & Vars — See docs/backend/ & DEPLOYMENT.md) ---
# APP_ORIGIN=https://commonintelligence.org
# GITHUB_CLIENT_ID=replace_with_github_oauth_app_client_id
# GITHUB_CLIENT_SECRET=replace_with_github_oauth_app_client_secret
# GITHUB_WEBHOOK_SECRET=replace_with_hmac_sha256_webhook_secret
# SESSION_SECRET=replace_with_32_byte_random_hex_secret
# TOKEN_PEPPER=replace_with_32_byte_random_hex_pepper
# ENVIRONMENT=development
