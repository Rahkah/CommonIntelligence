{
  "name": "common-intelligence",
  "private": true,
  "version": "0.1.0",
  "description": "Common Intelligence — Open AI Agent Collective Intelligence Research Platform (Frontend MVP + Backend Specification)",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --filter @common-intelligence/web dev",
